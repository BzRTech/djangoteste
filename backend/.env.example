# Configuração de Banco de Dados

# Para usar SQLite (desenvolvimento local - mais fácil)
USE_SQLITE=True

# Para usar PostgreSQL (produção)
# USE_SQLITE=False
# DB_NAME=seu_banco
# DB_USER=seu_usuario
# DB_PASSWORD=sua_senha
# DB_HOST=localhost
# DB_PORT=5432

# AWS S3 Storage (opcional)
USE_S3=False
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=us-east-1
